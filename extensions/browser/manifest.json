{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.0",
  "version_name": "0.3.0-alpha",
  "minimum_chrome_version": "111",
  "default_locale": "en_US",
  "icons": {
    "16": "icons/brand-16.png",
    "32": "icons/brand-32.png",
    "48": "icons/brand-48.png",
    "128": "icons/brand-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/brand-16.png",
      "32": "icons/brand-32.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://onedrive.live.com/*", "https://drive.google.com/*", "http://localhost/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://onedrive.live.com/*", "https://drive.google.com/*"],
    "js": ["material.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://onedrive.live.com/*", "https://drive.google.com/*"],
    "js": ["website.js"],
    "world": "ISOLATED",
    "run_at": "document_idle"
  }, {
    "matches": ["http://localhost/*"],
    "js": ["workspace.js"],
    "run_at": "document_idle"
  }],
  "incognito": "not_allowed"
}
